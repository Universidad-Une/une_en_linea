---
// ContactSection.astro
import { ChevronDown } from "@lucide/astro";
import { Image } from "astro:assets";
import Instalaciones from "@/assets/imagenes/Sillas.webp";
import { CAMPOS_INSCRIPCION } from "@server/validacion.mjs";
import { etiquetaOpcion } from "@/components/inscripcion/etiquetas.mjs";
export interface Props {
  title?: string;
  subtitle?: string;
  className?: string;
  formSource?: string;
  backgroundImage?: boolean;
  /** Programa preseleccionado; si se omite, se deduce de la URL de la página. */
  programa?: string;
}

const {
  title = "Déjanos tus datos y nos contactaremos contigo",
  subtitle = "Estamos para ti",
  className = "",
  formSource = "form_home",
  backgroundImage = false,
  programa,
} = Astro.props;

const opcionesDe = (campo: string) =>
  (CAMPOS_INSCRIPCION.find(([nombre]) => nombre === campo)?.[5] ?? []) as string[];
const programas = opcionesDe("programaAcademico");
const edades = opcionesDe("edad");
const medios = opcionesDe("mediosSeleccionados");

// Página de oferta académica → opción exacta del Google Form.
const programaPorPagina: Record<string, string> = {
  bachillerato: "Bachillerato en linea",
  administracion: "Lic. en administracion",
  administracion_sistemas_informacion: "Lic. en ad de sistemas de informacion",
  comercio_y_negocios_globales: "Lic. en comercio y negocios globales",
  comunicacion: "Lic. en comunicacion",
  contaduria: "Lic. en contaduria",
  derecho: "Lic. en derecho",
  diseno_grafico: "Lic. en diseño grafico",
  educacion: "Lic. en educacion",
  ingenieria_industrial: "Ing. industrial",
  mercadotecnia: "Lic. en mercadotecnia",
  psicologia: "Lic. en psicologia",
  maestria_administracion_negocios: "Maestria en administracion de negocios",
  maestria_educacion: "Maestria en educacion",
};
const pagina = Astro.url.pathname.replace(/\/+$/, "").split("/").pop() ?? "";
const programaInicial = programa ?? programaPorPagina[pagina] ?? "";
const claseCampo =
  "w-full bg-transparent border-b-2 border-white/60 text-white placeholder-white/80 py-2 sm:py-3 2xl:py-4 focus:outline-none focus:border-white transition-colors text-base sm:text-lg 2xl:text-xl";
const claseSelect = `${claseCampo} appearance-none cursor-pointer [&>option]:text-gray-900 [&>option]:bg-white`;
---

<section id="contact-shared" class={`relative py-12 sm:py-16 px-4 min-h-[400px] ${className}`}>
  {backgroundImage ? (
    <!-- Background Image -->
    <div class="absolute inset-0">
      <Image
        src={Instalaciones}
        alt="Instalaciones UNE"
        class="w-full h-full object-cover"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-black/40"></div>
    </div>
  ) : (
    <!-- Gradient Background -->
    <div class="absolute inset-0 bg-gradient-to-br from-[#001A71] to-[#0A2DAA]">
    </div>
  )}

  <div class="relative z-10 max-w-6xl 2xl:max-w-7xl min-[1920px]:max-w-[1440px] mx-auto">
    <div
      class="grid lg:grid-cols-2 gap-8 lg:gap-12 2xl:gap-20 items-start lg:items-center"
    >
      <!-- Left Column: Title -->
      <div class="text-white text-center lg:text-left">
        <p class="text-base sm:text-lg 2xl:text-xl font-medium mb-3 sm:mb-4">{subtitle}</p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl 2xl:text-6xl font-bold leading-tight">
          {title}
        </h2>
      </div>

      <!-- Right Column: Form -->
      <div class="w-full">
        <!-- Message Display Area -->
        <div id="message-container" class="mb-4 hidden">
          <div
            id="message-content"
            class="rounded-lg p-4 flex items-start gap-3 animate-fade-in"
          >
            <div id="message-icon" class="flex-shrink-0 mt-0.5"></div>
            <div class="flex-1 min-w-0">
              <p
                id="message-text"
                class="text-sm sm:text-base font-medium break-words"
              >
              </p>
              <button
                id="retry-btn"
                class="mt-2 text-sm underline hover:no-underline hidden"
              >
                Intentar de nuevo
              </button>
            </div>
          </div>
        </div>

        <form
          id="contact-form"
          data-form-source={formSource}
          class="space-y-4 sm:space-y-6 flex flex-col"
        >
          <input
            type="text"
            name="nombres"
            placeholder="Nombre completo"
            aria-label="Nombre completo"
            required
            minlength="2"
            maxlength="500"
            autocomplete="name"
            class={claseCampo}
          />

          <div class="relative">
            <select
              name="programaAcademico"
              aria-label="Programa de interés"
              required
              class={claseSelect}
            >
              <option value="" disabled selected={!programaInicial}>Programa de interés</option>
              {
                programas.map((opcion) => (
                  <option value={opcion} selected={opcion === programaInicial}>
                    {etiquetaOpcion("programaAcademico", opcion)}
                  </option>
                ))
              }
            </select>
            <ChevronDown
              className="absolute right-0 top-1/2 -translate-y-1/2 w-4 h-4 sm:w-5 sm:h-5 text-white/80 pointer-events-none"
            />
          </div>

          <input
            type="tel"
            name="telefonoContacto"
            placeholder="Teléfono (10 dígitos)"
            aria-label="Teléfono (10 dígitos)"
            required
            pattern="[0-9]{10}"
            minlength="10"
            maxlength="10"
            title="Por favor ingresa 10 dígitos"
            autocomplete="tel"
            inputmode="numeric"
            class={claseCampo}
          />

          <input
            type="email"
            name="correo"
            placeholder="Correo electrónico"
            aria-label="Correo electrónico"
            required
            maxlength="500"
            autocomplete="email"
            class={claseCampo}
          />

          <div class="relative">
            <select name="edad" aria-label="Edad" required class={claseSelect}>
              <option value="" disabled selected>Edad</option>
              {edades.map((opcion) => <option value={opcion}>{etiquetaOpcion("edad", opcion)}</option>)}
            </select>
            <ChevronDown
              className="absolute right-0 top-1/2 -translate-y-1/2 w-4 h-4 sm:w-5 sm:h-5 text-white/80 pointer-events-none"
            />
          </div>

          <fieldset class="text-white">
            <legend class="text-base sm:text-lg 2xl:text-xl text-white/80 mb-2">¿Cómo nos conociste?</legend>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-2 2xl:gap-y-3 text-sm sm:text-base 2xl:text-lg">
              {
                medios.map((opcion) => (
                  <label class="inline-flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" name="mediosSeleccionados" value={opcion} class="accent-white w-4 h-4" />
                    <span>{etiquetaOpcion("mediosSeleccionados", opcion)}</span>
                  </label>
                ))
              }
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="checkbox" name="mediosSeleccionados" value="__otro__" data-other-choice class="accent-white w-4 h-4" />
                <span>Otro</span>
              </label>
            </div>
            <input
              type="text"
              data-other-text
              placeholder="¿Cuál?"
              aria-label="Otro medio por el que nos conociste"
              maxlength="500"
              disabled
              class={`${claseCampo} mt-2 hidden`}
            />
          </fieldset>

          <button
            type="submit"
            id="submit-btn"
            class="w-full bg-white text-[#001A71] hover:bg-gray-100  py-3 sm:py-4 px-6 sm:px-8 rounded transition-all duration-200 text-base sm:text-lg shadow-lg hover:shadow-xl disabled:opacity-50 disabled:cursor-not-allowed mt-4 flex items-center justify-center gap-2"
          >
            <span id="btn-text">Enviar información</span>
            <svg
              id="loading-spinner"
              class="hidden animate-spin h-5 w-5"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"></circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
              ></path>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.3s ease-out;
  }

  /* Ensure form inputs are readable on mobile */
  @media (max-width: 640px) {
    input,
    select {
      font-size: 16px !important; /* Prevents zoom on iOS */
    }
  }
</style>

<script>
  import { validarInscripcion } from "@server/validacion.mjs";
  import { etiquetaOpcion } from "@/components/inscripcion/etiquetas.mjs";

  const WHATSAPP_NUMBER = "3380000801";
  const TIMEOUT_MS = 15000;

  type MessageType = "error" | "success" | "warning" | "info";
  type Datos = Record<string, string | string[]>;

  const etiquetas: Record<string, string> = {
    nombres: "nombre",
    programaAcademico: "programa",
    telefonoContacto: "teléfono (10 dígitos)",
    correo: "correo",
    edad: "edad",
    mediosSeleccionados: "¿cómo nos conociste?",
  };

  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const submitBtn = document.getElementById(
      "submit-btn"
    ) as HTMLButtonElement;
    const btnText = document.getElementById("btn-text");
    const loadingSpinner = document.getElementById("loading-spinner");
    const messageContainer = document.getElementById("message-container");
    const messageContent = document.getElementById("message-content");
    const messageText = document.getElementById("message-text");
    const messageIcon = document.getElementById("message-icon");
    const retryBtn = document.getElementById("retry-btn");

    if (!form || !submitBtn) return;

    const otroCheck = form.querySelector<HTMLInputElement>("[data-other-choice]")!;
    const otroTexto = form.querySelector<HTMLInputElement>("[data-other-text]")!;
    const primerMedio = form.querySelector<HTMLInputElement>(
      '[name="mediosSeleccionados"]'
    )!;

    let lastData: Datos | null = null;

    // Mismo formato que valida la API (server/validacion.mjs).
    const recolectar = (): Datos => {
      const formData = new FormData(form);
      const texto = (campo: string) => String(formData.get(campo) ?? "").trim();
      return {
        origenFormulario: form.dataset.formSource || "form_home",
        rutaProcedencia: window.location.pathname,
        nombres: texto("nombres"),
        programaAcademico: texto("programaAcademico"),
        telefonoContacto: texto("telefonoContacto"),
        correo: texto("correo"),
        edad: texto("edad"),
        mediosSeleccionados: formData
          .getAll("mediosSeleccionados")
          .map((valor) => (valor === "__otro__" ? otroTexto.value.trim() : String(valor))),
      };
    };

    // "¿Cómo nos conociste?" es obligatorio y "Otro" requiere texto.
    const validarMedios = () => {
      otroTexto.disabled = !otroCheck.checked;
      otroTexto.required = otroCheck.checked;
      otroTexto.classList.toggle("hidden", !otroCheck.checked);
      otroTexto.setCustomValidity(
        otroCheck.checked && !otroTexto.value.trim() ? "Especifica el otro medio." : ""
      );
      primerMedio.setCustomValidity(
        form.querySelector('[name="mediosSeleccionados"]:checked')
          ? ""
          : "Selecciona al menos una opción."
      );
    };
    form.addEventListener("change", validarMedios);
    form.addEventListener("input", validarMedios);
    validarMedios();

    // Show message to user
    const showMessage = (
      message: string,
      type: MessageType = "info",
      showRetry: boolean = false
    ) => {
      if (
        !messageContainer ||
        !messageContent ||
        !messageText ||
        !messageIcon ||
        !retryBtn
      )
        return;

      // Set message text
      messageText.textContent = message;

      // Set icon and colors based on type
      const iconClasses = "w-5 h-5 sm:w-6 sm:h-6 flex-shrink-0";
      let bgColor = "";
      let textColor = "";
      let iconSvg = "";

      switch (type) {
        case "error":
          bgColor = "bg-red-500/90";
          textColor = "text-white";
          iconSvg = `<svg class="${iconClasses}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`;
          break;
        case "success":
          bgColor = "bg-green-500/90";
          textColor = "text-white";
          iconSvg = `<svg class="${iconClasses}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`;
          break;
        case "warning":
          bgColor = "bg-yellow-500/90";
          textColor = "text-gray-900";
          iconSvg = `<svg class="${iconClasses}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>`;
          break;
        default:
          bgColor = "bg-blue-500/90";
          textColor = "text-white";
          iconSvg = `<svg class="${iconClasses}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`;
      }

      messageContent.className = `rounded-lg p-4 flex items-start gap-3 animate-fade-in ${bgColor} ${textColor}`;
      messageIcon.innerHTML = iconSvg;

      // Show/hide retry button
      if (showRetry) {
        retryBtn.classList.remove("hidden");
      } else {
        retryBtn.classList.add("hidden");
      }

      // Show message container
      messageContainer.classList.remove("hidden");

      // Auto-hide success messages after 5 seconds
      if (type === "success") {
        setTimeout(() => {
          messageContainer.classList.add("hidden");
        }, 5000);
      }
    };

    // Hide message
    const hideMessage = () => {
      if (messageContainer) {
        messageContainer.classList.add("hidden");
      }
    };

    // Show loading state
    const setLoading = (isLoading: boolean) => {
      if (isLoading) {
        submitBtn.setAttribute("disabled", "true");
        btnText!.textContent = "Enviando...";
        loadingSpinner!.classList.remove("hidden");
      } else {
        submitBtn.removeAttribute("disabled");
        btnText!.textContent = "Enviar información";
        loadingSpinner!.classList.add("hidden");
      }
    };

    // WhatsApp fallback
    const sendToWhatsApp = (data: Datos) => {
      const nombre = String(data.nombres || "");
      const programa = data.programaAcademico
        ? etiquetaOpcion("programaAcademico", String(data.programaAcademico))
        : "Informes";
      const msg = `Hola, intenté registrarme en la web pero hubo un problema. %0A*Nombre:* ${encodeURIComponent(nombre)}%0A*Interés:* ${encodeURIComponent(programa)}`;

      showMessage(
        "Redirigiendo a WhatsApp para completar tu registro...",
        "info"
      );

      setTimeout(() => {
        window.location.href = `https://wa.me/${WHATSAPP_NUMBER}?text=${msg}`;
      }, 1500);
    };

    const camposConError = (errores: Record<string, string>) =>
      Object.keys(errores)
        .map((campo) => etiquetas[campo] || campo)
        .join(", ");

    // Submit form
    const submitForm = async (data: Datos) => {
      hideMessage();

      const { errors } = validarInscripcion(data);
      if (Object.keys(errors).length) {
        showMessage(`Revisa estos campos: ${camposConError(errors)}.`, "error");
        return;
      }

      setLoading(true);

      try {
        const response = await fetch("/api/forms/inscripcion", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(data),
          signal: AbortSignal.timeout(TIMEOUT_MS),
        });
        const result = await response.json().catch(() => ({}));

        if (response.ok && result.success === true) {
          // 202: la solicitud quedó guardada; el envío a Google ocurre después.
          showMessage("¡Registro exitoso! Redirigiendo...", "success");
          setTimeout(() => {
            const source = form.dataset.formSource || "form_home";
            window.location.href = `/contacto/gracias/?source=${source}`;
          }, 1500);
        } else if (response.status === 400 && result.fields) {
          showMessage(`Revisa estos campos: ${camposConError(result.fields)}.`, "error");
        } else if (response.status === 429) {
          showMessage(
            result.message || "Has realizado demasiadas solicitudes. Espera un momento.",
            "warning"
          );
        } else {
          console.error("Server error:", response.status);
          showMessage(
            "El servidor está experimentando problemas. ¿Deseas contactarnos por WhatsApp?",
            "error",
            true
          );
        }
      } catch (err: any) {
        console.error("Error en envío:", err);

        if (err.name === "TimeoutError" || err.name === "AbortError") {
          // Timeout error
          showMessage(
            "La conexión está tardando más de lo esperado. ¿Deseas contactarnos por WhatsApp?",
            "warning",
            true
          );
        } else if (!navigator.onLine) {
          // Network offline
          showMessage(
            "No hay conexión a internet. Por favor, verifica tu conexión e intenta de nuevo.",
            "error",
            true
          );
        } else {
          // Other errors
          showMessage(
            "Ocurrió un error al enviar el formulario. ¿Deseas contactarnos por WhatsApp?",
            "error",
            true
          );
        }
      } finally {
        setLoading(false);
      }
    };

    // Form submit handler
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      validarMedios();
      if (!form.reportValidity()) return;
      lastData = recolectar();
      await submitForm(lastData);
    });

    // Retry button handler - sends to WhatsApp
    retryBtn?.addEventListener("click", () => {
      if (lastData) {
        sendToWhatsApp(lastData);
      }
    });

    // Monitor online/offline status
    window.addEventListener("online", () => {
      if (messageContainer && !messageContainer.classList.contains("hidden")) {
        showMessage(
          "Conexión restaurada. Puedes intentar enviar el formulario nuevamente.",
          "success"
        );
        setTimeout(hideMessage, 3000);
      }
    });

    window.addEventListener("offline", () => {
      showMessage("Se perdió la conexión a internet.", "error");
    });
  });
</script>
