[Unit]
Description=API de inscripcion UNE (Astro)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/une_en_linea
EnvironmentFile=/etc/une-inscripcion.env
Environment=HOST=127.0.0.1
Environment=PORT=4321
ExecStart=/usr/bin/node /var/www/une_en_linea/dist/server/entry.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
