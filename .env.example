# Copia este archivo a .env. API, worker y db:* lo cargan si existe;
# las variables del proceso (PM2) tienen prioridad.

# --- Receptor de Google (server/apps-script/README.md) — obligatorias ---
# URL /exec de la aplicación web de Apps Script.
GOOGLE_FORMS_SCRIPT_URL=
# Igual a SHARED_SECRET en las propiedades del script. Mínimo 32 caracteres.
GOOGLE_FORMS_SHARED_SECRET=

# --- SQLite — obligatoria ---
# Local: ruta relativa. VPS: ruta absoluta, persistente, fuera de dist/ y con
# permisos de escritura en el archivo y su carpeta (WAL/SHM).
SQLITE_DB_PATH=./data/inscripciones.sqlite

# --- API ---
# Mantener 127.0.0.1: el puerto no debe ser accesible desde Internet.
API_HOST=127.0.0.1
# Debe coincidir con nginx (deploy/nginx-inscripcion.conf) y el proxy de astro.config.mjs.
API_PORT=4322

# --- Worker: reintentos ---
# Total de envíos por inscripción, incluido el primero. Al agotarse: needs_review=1.
INSCRIPCION_MAX_ATTEMPTS=5
# Primera espera entre intentos (ms). Crece exponencialmente con ±20% de variación.
INSCRIPCION_RETRY_BASE_MS=60000
# Tope de la espera entre intentos (ms). Debe ser >= RETRY_BASE_MS.
INSCRIPCION_RETRY_MAX_MS=3600000
# Pausa del worker cuando la cola está vacía (ms).
INSCRIPCION_POLL_MS=5000

# --- API: límite de peticiones (ventana deslizante, en memoria, por proceso) ---
# Peticiones por IP en la ventana. Ojo con redes compartidas (escuelas, oficinas).
INSCRIPCION_RATE_LIMIT_PER_IP=5
# Peticiones totales de todas las IP en la ventana.
INSCRIPCION_RATE_LIMIT_GLOBAL=60
INSCRIPCION_RATE_LIMIT_WINDOW_MS=60000
# false: Node directo/local, usa la IP del socket.
# true: solo detrás de nginx, que sobrescribe X-Real-IP. Nunca con el puerto expuesto.
INSCRIPCION_TRUST_PROXY=false
