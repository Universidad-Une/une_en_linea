{
  "name": "une-enlinea",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/astro/astro.js dev",
    "build": "astro build",
    "start": "npm run api",
    "api": "node --env-file-if-exists=.env server/api.mjs",
    "db:init": "node --env-file-if-exists=.env server/scripts/init-db.mjs",
    "db:query": "node --env-file-if-exists=.env server/scripts/query-db.mjs",
    "worker": "node --env-file-if-exists=.env server/worker.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test server/test/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "@lucide/astro": "^0.555.0",
    "@splidejs/splide": "^4.1.4",
    "@splidejs/splide-extension-auto-scroll": "^0.5.3",
    "@splidejs/splide-extension-intersection": "^0.2.0",
    "@tailwindcss/vite": "^4.1.17",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/slim": "^3.9.1",
    "astro": "^5.17.1",
    "better-sqlite3": "^13.0.3",
    "lucide-astro": "^0.555.0",
    "splide": "0.0.1-security",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^25.0.10"
  },
  "allowScripts": {
    "@tsparticles/engine@3.9.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.2": true,
    "sharp@0.34.5": true
  }
}
