{
  "name": "une-enlinea",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs dev",
    "build": "astro build",
    "start": "npm run api",
    "api": "node --env-file-if-exists=.env server/api.mjs",
    "db:init": "node --env-file-if-exists=.env server/db-cli.mjs init",
    "db:query": "node --env-file-if-exists=.env server/db-cli.mjs query",
    "worker": "node --env-file-if-exists=.env server/worker.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test server/test/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@lucide/astro": "^1.81.0",
    "@splidejs/splide": "^4.1.4",
    "@splidejs/splide-extension-auto-scroll": "^0.5.3",
    "@splidejs/splide-extension-intersection": "^0.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/slim": "^3.9.1",
    "astro": "7.4.13",
    "better-sqlite3": "^12.11.1",
    "lucide-astro": "^0.555.0",
    "splide": "0.0.1-security",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^25.0.10",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "@tsparticles/engine@3.9.1": true,
    "better-sqlite3@12.11.1": true
  }
}
